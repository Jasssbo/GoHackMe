<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for GoHackMe.

  The game server runs on the LAN (ws://) without TLS. Android 9+ (API 28+)
  blocks cleartext traffic by default. We allow it ONLY for private LAN
  subnets so the app never downgrades security for public internet hosts.

  Private RFC-1918 ranges:
    10.0.0.0/8       (Class A)
    172.16.0.0/12    (Class B)
    192.168.0.0/16   (Class C)

  We also allow localhost for development / same-device testing.
-->
<network-security-config>
    <!-- Production: allow cleartext only on private LAN subnets -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- LAN subnets — covers most home / office routers -->
        <domain includeSubdomains="false">10.*</domain>
        <domain includeSubdomains="false">172.16.*</domain>
        <domain includeSubdomains="false">192.168.*</domain>
    </domain-config>

    <!-- Everything else uses the system default (cleartext blocked on API 28+) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
