<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for GoHackMe.

  The LAN game server communicates over ws:// (no TLS). Android 9+ (API 28+)
  blocks cleartext HTTP/WebSocket by default.

  IMPORTANT — Android's <domain> element matches DNS hostnames only, NOT IP
  address ranges. Wildcards like "10.*" are not valid and are silently ignored.
  Since LAN server IPs are user-assigned and dynamic, there is no way to
  whitelist them by hostname pattern.

  Decision: allow cleartext for ALL destinations. This is standard practice
  for LAN-only gaming apps where the user explicitly connects to their own
  server on a trusted local network. Public internet connections use only
  WebRTC data channels (DTLS-encrypted end-to-end) or wss:// (TLS).

  See: https://developer.android.com/privacy-and-security/security-config
-->
<network-security-config>
    <!-- Allow cleartext to any host (ws:// LAN server + localhost dev). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Debug builds additionally trust user-installed CAs (e.g. Charles proxy). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
