<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Config for GoHackMe.

  LAN multiplayer uses raw Dart TCP sockets (dart:io Socket / ServerSocket).
  These go through the Dart I/O layer directly and are NOT subject to Android's
  Network Security Config — NSC only governs traffic routed through the Android
  HTTP/HTTPS stack (HttpURLConnection, OkHttp, etc.).

  Therefore we can safely set cleartextTrafficPermitted="false" globally:
    • Wired (internet) mode already uses wss:// (TLS) — enforced in code.
    • LAN mode uses raw TCP — bypasses NSC entirely, unaffected by this flag.
    • localhost is explicitly whitelisted for local development convenience.

  See: https://developer.android.com/privacy-and-security/security-config
-->
<network-security-config>
    <!-- Block cleartext HTTP/WebSocket to all internet hosts by default. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext only to localhost (local dev / emulator). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Debug builds additionally trust user-installed CAs (e.g. Charles proxy). -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
